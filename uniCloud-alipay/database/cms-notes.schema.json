// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": ["user_id", "cover", "content"],
	"permission": {
		"read": true,
		"create": "auth.uid != null",
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"user_id": {
			"bsonType": "string",
			"description": "作者ID， 参考`uni-id-users` 表",
			"foreignKey": "uni-id-users._id",
			"defaultValue": {
				"$env": "uid"
			}
		},
		"cover": {
			"bsonType": "string",
			"title": "封面大图",
			"description": "缩略图地址",
			"label": "封面大图",
			"trim": "both"
		},
		"coverFile": {
			"bsonType": "object",
			"title": "封面大图",
			"description": "缩略图对象",
			"label": "封面大图"
		},
		 "content": {
		 	"bsonType": "string",
		 	"title": "note文字内容",
		 	"description": "note文字内容",
		 	"label": "note文字内容",
		 	"trim": "right"
		 },
		 "view_count": {
		 	"bsonType": "int",
		 	"title": "阅读数量",
		 	"description": "阅读数量",
		 	"permission": {
		 		"write": false
		 	}
		 },
		 "like_count": {
		 	"bsonType": "int",
		 	"description": "喜欢数、点赞数",
		 	"permission": {
		 		"write": false
		 	}
		 },
		 "publish_date": {
		 	"bsonType": "timestamp",
		 	"title": "发表时间",
		 	"description": "发表时间",
		 	"defaultValue": {
		 		"$env": "now"
		 	}
		 },
		 "publish_ip": {
		 	"bsonType": "string",
		 	"title": "发布文章时IP地址",
		 	"description": "发表时 IP 地址",
		 	"forceDefaultValue": {
		 		"$env": "clientIP"
		 	}
		 },
		 "last_modify_date": {
		 	"bsonType": "timestamp",
		 	"title": "最后修改时间",
		 	"description": "最后修改时间",
		 	"defaultValue": {
		 		"$env": "now"
		 	}
		 },
		 "last_modify_ip": {
		 	"bsonType": "string",
		 	"description": "最后修改时 IP 地址",
		 	"forceDefaultValue": {
		 		"$env": "clientIP"
		 	}
		 }
	}
}